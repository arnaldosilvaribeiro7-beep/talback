# Configuracao SMTP para envio real de codigos de 6 digitos (@gmail.com) pelas Cloud Functions.
# Copie este arquivo para functions/.env antes de executar:
#   firebase deploy --only functions,firestore:indexes,storage
# Nunca envie functions/.env para o GitHub (ja esta no .gitignore).

SMTP_USER=seu-remetente@gmail.com
SMTP_PASS=sua-senha-de-aplicativo-de-16-caracteres
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=seu-remetente@gmail.com
