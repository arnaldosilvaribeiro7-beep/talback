rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    match /chat_attachments/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /server_attachments/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /avatars/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /banners/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && request.resource.size <= 6 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /banner_videos/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && request.resource.size <= 15 * 1024 * 1024 && request.resource.contentType.matches('video/.*');
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
